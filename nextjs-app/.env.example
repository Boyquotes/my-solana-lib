# Copy this file to .env.local and update the values as needed

# Solana RPC URL - this will be used as the default RPC endpoint
NEXT_PUBLIC_RPC=https://api.mainnet-beta.solana.com

# Alternative RPC URLs you can use:
# NEXT_PUBLIC_RPC=https://api.devnet.solana.com
# NEXT_PUBLIC_RPC=https://api.testnet.solana.com
# NEXT_PUBLIC_RPC=http://localhost:8899
